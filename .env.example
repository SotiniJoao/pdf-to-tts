OPENAI_API_KEY=sk-...

# Opcionais
# OCR_MODEL=gpt-5-nano
# LANGUAGE=es                # língua ao abrir: es (espanhol) ou pt (português); Ctrl+Alt+T alterna
# TTS_VOICE_ES=es-ES-ElviraNeural   # ex.: es-MX-DaliaNeural, es-AR-ElenaNeural
# TTS_VOICE_PT=pt-BR-FranciscaNeural
# TRANSLATE_MODEL=gpt-5-nano
# TRANSLATE_REASONING=minimal  # use low se a tradução vier resumida
# TTS_RATE=+10%
# READ_HOTKEY=<ctrl>+<alt>+r
# PAUSE_HOTKEY=<ctrl>+<alt>+p
# STOP_HOTKEY=<ctrl>+<alt>+s
# REPLAY_HOTKEY=<ctrl>+<alt>+l
# LANGUAGE_HOTKEY=<ctrl>+<alt>+t
# QUIT_HOTKEY=<ctrl>+<alt>+q
# OUTPUT_DIR=narracoes       # onde ficam 1.txt/1.es.txt/1.mp3, 2.*...
# AUTO_PLAY=true             # false = só salva; toca com o atalho de repetir
# MONITOR=1                 # só no modo monitor
# CAPTURE_MODE=window        # window = janela em foco, monitor = monitor inteiro
# DEBUG_CAPTURES_DIR=debug/ocr   # salva cada print aqui para conferir
# DEBUG_CAPTURES_KEEP=20
# DEBUG_TEXTS_DIR=debug/text
